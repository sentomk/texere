@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# texere is a static library, so the dependencies it was compiled against are
# part of its link interface (CMake records private ones as LINK_ONLY, which
# consumers still link). They have to be findable before texere-targets.cmake
# is included, or the imported targets would reference something that does not
# exist.
#
# These are the same switches the build was configured with; configure_file
# substitutes them here.
if(@TEXERE_USE_SIMDUTF@)
    find_dependency(simdutf CONFIG)
endif()
if(@TEXERE_USE_UNIALGO@)
    find_dependency(uni-algo CONFIG)
endif()
if(@TEXERE_USE_FMT@)
    find_dependency(fmt CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/texere-targets.cmake")

check_required_components(texere)
